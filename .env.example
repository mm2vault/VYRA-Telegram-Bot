# Copy these into your hosting provider's Environment/Secrets settings.
# Never commit real tokens or API keys.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AUTO_POST_TIMES=10:00,15:00,20:00
DATA_DIR=./data
# For a Render persistent disk mounted at /var/data, set DATA_DIR=/var/data
PORT=3000
